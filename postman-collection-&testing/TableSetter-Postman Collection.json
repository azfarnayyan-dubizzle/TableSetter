              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chicken Samosa\",\n  \"description\": \"Crispy pastry with spiced chicken filling\",\n  \"price\": 250,\n  \"is_available\": true\n}"
            },
            "url": "{{base_url}}/owner/categories/{{category_id}}/menu-items"
          }
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{owner_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 275\n}"
            },
            "url": "{{base_url}}/owner/menu-items/{{menu_item_id}}"
          }
        },
        {
          "name": "Delete Menu Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_token}}" }],
            "url": "{{base_url}}/owner/menu-items/{{menu_item_id}}"
          }
        }
      ]
    },
    {
      "name": "Owner - Reviews",
      "item": [
        {
          "name": "List Restaurant Reviews",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_token}}" }],
            "url": "{{base_url}}/owner/restaurants/{{restaurant_id}}/reviews"
