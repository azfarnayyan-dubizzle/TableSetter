            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Updated review after second visit\"\n}"
            },
            "url": "{{base_url}}/customer/reviews/{{review_id}}"
          }
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/customer/reviews/{{review_id}}"
          }
