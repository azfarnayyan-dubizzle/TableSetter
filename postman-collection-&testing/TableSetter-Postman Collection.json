        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/restaurants"
          }
        },
        {
          "name": "Get Restaurant Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/restaurants/{{restaurant_id}}"
          }
        },
        {
          "name": "Search Restaurants",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/search/restaurants?q=pizza"
          }
        }
      ]
    }
