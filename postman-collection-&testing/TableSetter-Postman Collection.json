    {
      "name": "Customer - Dining Logs",
      "item": [
        {
          "name": "List Dining Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/customer/dining-logs"
          }
        },
        {
          "name": "Create Dining Log",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const data = pm.response.json();",
                "  pm.collectionVariables.set('dining_log_id', data.data ? data.data.id : data.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant_id\": {{restaurant_id}},\n  \"amount_spent\": 1250.50,\n  \"note\": \"Dinner with friends\"\n}"
            },
            "url": "{{base_url}}/customer/dining-logs"
          }
        },
        {
          "name": "Update Dining Log",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount_spent\": 1400\n}"
            },
            "url": "{{base_url}}/customer/dining-logs/{{dining_log_id}}"
          }
        },
        {
          "name": "Delete Dining Log",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/customer/dining-logs/{{dining_log_id}}"
          }
        },
        {
          "name": "Monthly Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }],
            "url": "{{base_url}}/customer/dining-logs/summary"
